# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url-here

# Supabase renamed the client-side key from "anon key" to "publishable key".
# The app accepts EITHER name — use whichever your dashboard shows. Newer
# projects get VITE_SUPABASE_PUBLISHABLE_KEY; older ones get the anon key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Application URL (IMPORTANT for OAuth security)
# Set this to your production domain in Vercel environment variables
# NOTE: The allowed origins list in supabaseClient.js includes both 'rem-way.vercel.app' and 'rem-way.vercel.app'.
#       Use 'rem-way.vercel.app' as the primary domain for production unless you have a specific reason to use the other.
VITE_APP_URL=https://rem-way.vercel.app

# AI Feedback (Google Gemini)
#
# ⚠️  WARNING: both variables below are currently read from browser code, and
# Vite inlines every VITE_-prefixed variable into dist/assets/*.js at build
# time. They are therefore PUBLIC on the deployed site. Use keys that are
# restricted and disposable, and see the "Known Issues" section of README.md
# for the plan to move these server-side.

# Required for the AI feedback system. Free tier available at
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Raises the GitHub API rate limit when fetching submitted
# repositories, and allows reading private repos. A fine-grained token with
# read-only public repo access is enough. Without it, only public repos are
# reachable and the unauthenticated rate limit applies.
VITE_GITHUB_TOKEN=

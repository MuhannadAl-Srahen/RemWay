# Normalize line endings to LF in the repository.
# Matches `endOfLine: "lf"` in .prettierrc so generated files (e.g.
# src/routeTree.gen.ts) stop showing as modified on Windows checkouts.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.mp4 binary
*.webm binary

# SVG is text, but treat it as such explicitly rather than relying on detection.
*.svg text eol=lf

# Lockfile is generated — keep diffs out of review.
bun.lock -diff linguist-generated=true

# Generated by the TanStack Router plugin.
src/routeTree.gen.ts linguist-generated=true
